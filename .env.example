# Copy to .env for local development. Never commit the real .env.
# Every variable is optional locally; see README.md for production requirements.

# --- Core (required on Render) ---
SECRET_KEY=change-me-to-a-long-random-string
ITEMSATIS_REDIRECT_URL=https://www.itemsatis.com/your-store
ADMIN_USERNAME=phoenixmarket
ADMIN_PASSWORD=change-me

# --- Storage (point both at a persistent disk in production) ---
# DATABASE_PATH=/var/data/phoenixmarket.db
# UPLOAD_DIR=/var/data/uploads
# Daily database copies (default: a "backups" folder next to DATABASE_PATH)
# BACKUP_DIR=/var/data/backups

# --- Language for first-time visitors and search engines (en or tr) ---
# DEFAULT_LOCALE=en

# --- Orders: hours to pay before an unpaid order is cancelled (0 = never) ---
# PENDING_ORDER_TTL_HOURS=24
# Days delivered account details / codes stay on the tracking page
# DELIVERY_RETENTION_DAYS=14
# Days sent emails stay under Admin → Emails (0 = keep all)
# OUTBOX_RETENTION_DAYS=0

# --- Host names the site answers to (recommended in production) ---
# TRUSTED_HOSTS=shop.example,www.shop.example

# --- Email (without SMTP_HOST, emails are only shown under Admin → Emails) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=PHOENIXMARKET <no-reply@example.com>
# SMTP_STARTTLS=1
# SMTP_SSL=0

# --- AI support chat (optional; FAQ answers without it) ---
# OPENAI_API_KEY=

# --- Exchange rates (optional overrides) ---
# EXCHANGE_RATE_API_URL=
# EXCHANGE_RATE_CACHE_SECONDS=3600
# EXCHANGE_RATE_REQUEST_TIMEOUT=3
# TRY_PER_USD=34.50
# EUR_PER_USD=0.92

# --- Development ---
# FLASK_DEBUG=0
