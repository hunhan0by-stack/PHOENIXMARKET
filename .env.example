# Copy to .env for local development. Never commit the real .env.
# Every variable is optional locally; see README.md for production requirements.

# --- Core (required on Render) ---
SECRET_KEY=change-me-to-a-long-random-string
ITEMSATIS_REDIRECT_URL=https://www.itemsatis.com/your-store
ADMIN_USERNAME=phoenixmarket
ADMIN_PASSWORD=change-me

# --- Storage (point both at a persistent disk in production) ---
# DATABASE_PATH=/var/data/phoenixmarket.db
# UPLOAD_DIR=/var/data/uploads

# --- Email (without SMTP_HOST, emails are only shown under Admin → Emails) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=PHOENIXMARKET <no-reply@example.com>
# SMTP_STARTTLS=1
# SMTP_SSL=0

# --- AI support chat (optional; FAQ answers without it) ---
# OPENAI_API_KEY=

# --- Exchange rates (optional overrides) ---
# EXCHANGE_RATE_API_URL=
# EXCHANGE_RATE_CACHE_SECONDS=3600
# EXCHANGE_RATE_REQUEST_TIMEOUT=3
# TRY_PER_USD=34.50
# EUR_PER_USD=0.92

# --- Development ---
# FLASK_DEBUG=0
